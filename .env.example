# ==============================================================================
# Ramesh's Bakery Loyalty App - Environment Variables Template
# Copy this file to .env.local and fill in your actual credentials.
# DO NOT COMMIT .env.local TO SOURCE CONTROL!
# ==============================================================================

# Privy Configuration (Get from https://dashboard.privy.io)
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here
PRIVY_APP_SECRET=your_privy_app_secret_here

# Ethereum / Sepolia Testnet Configuration
NEXT_PUBLIC_CHAIN_ID=11155111
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your_infura_project_id_here

# Bakery Staff / Owner Private Key (Used strictly on server to sign on-chain stamp transactions)
# NEVER expose this key to client-side code!
BAKERY_STAFF_PRIVATE_KEY=your_private_key_here

# Deployed Smart Contract Address on Sepolia
NEXT_PUBLIC_LOYALTY_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
